generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  createdAt  DateTime    @default(now())
  watchlists Watchlist[]
}

// EDGAR 由来の銘柄マスタ（全ユーザ共有）。
// 誰かがウォッチ登録した時点で追加し、ウォッチされなくなっても削除しない（ADR 0001）。
model Company {
  id         String      @id @default(uuid())
  cik        String      @unique
  name       String
  ticker     String // 変更・再利用があるため一意にしない。識別子は cik
  market     String
  createdAt  DateTime    @default(now())
  documents  Document[]
  financials Financial[]
  watchlists Watchlist[]

  @@index([ticker])
}

// ユーザごとのウォッチ銘柄。archivedAt が入っているものはアーカイブ（新着チェックの対象外）。
model Watchlist {
  id         String    @id @default(uuid())
  userId     String
  companyId  String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
}

model Document {
  id        String            @id @default(uuid())
  title     String
  fileUrl   String
  companyId String
  createdAt DateTime          @default(now())
  company   Company           @relation(fields: [companyId], references: [id])
  contents  DocumentContent[]
  fiscalYear Int
  quarter    Int?
  periodType String
  financials Financial[]
}

model DocumentContent {
  id         String   @id @default(uuid())
  documentId String
  contentEn  String
  contentJa  String?
  orderIndex Int  
  document   Document @relation(fields: [documentId], references: [id])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiredAt DateTime
}

model Financial {
  id        String   @id @default(uuid())
  companyId String
  fiscalYear    Int
  fiscalQuarter Int?
  periodType    String // "Q" or "FY"
  revenue              Float?
  netIncomeGaap        Float?
  netIncomeNonGaap     Float?
  documentId String?
  company   Company  @relation(fields: [companyId], references: [id])
  document  Document? @relation(fields: [documentId], references: [id])
  createdAt DateTime @default(now())
  @@unique([companyId, fiscalYear, fiscalQuarter, periodType])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  documents Document[]
}

model Company {
  id        String     @id @default(uuid())
  cik       String     @unique
  name      String
  ticker    String     @unique
  market    String
  createdAt DateTime   @default(now())
  documents Document[]
  financials Financial[]
}

model Document {
  id        String            @id @default(uuid())
  title     String
  fileUrl   String
  companyId String
  createdAt DateTime          @default(now())
  userId    String?
  company   Company           @relation(fields: [companyId], references: [id])
  user      User?             @relation(fields: [userId], references: [id])
  contents  DocumentContent[]
  fiscalYear Int
  quarter    Int?
  periodType String
  financials Financial[]
}

model DocumentContent {
  id         String   @id @default(uuid())
  documentId String
  contentEn  String
  contentJa  String?
  orderIndex Int  
  document   Document @relation(fields: [documentId], references: [id])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiredAt DateTime
}

model Financial {
  id        String   @id @default(uuid())
  companyId String
  fiscalYear    Int
  fiscalQuarter Int?
  periodType    String // "Q" or "FY"
  revenue              Float?
  netIncomeGaap        Float?
  netIncomeNonGaap     Float?
  documentId String?
  company   Company  @relation(fields: [companyId], references: [id])
  document  Document? @relation(fields: [documentId], references: [id])
  createdAt DateTime @default(now())
  @@unique([companyId, fiscalYear, fiscalQuarter, periodType])
}

PORT=3000
FRONTEND_URL="http://localhost:5173"
BATCH_SECRET="test"
# docker composeを使わずbackendをローカルで直接動かす場合、edgar-checkerも
# 別途 `go run .` などで起動し、そのURLをここに指定する
EDGAR_CHECKER_URL="http://localhost:8080"
DATABASE_URL="postgresql://user:password@db:5432/app_db"
JWT_SECRET=
# mcp-server → backend の内部 API（/internal/*）の共有シークレット。必須。mcp-server と同じ値にする
INTERNAL_API_SECRET=
MCP_API_KEY=
# MCP_API_KEY で呼ばれたときに扱うユーザの User.id（MCP_API_KEY を設定する場合は必須。暫定措置）
MCP_API_KEY_USER_ID=
OPENAI_API_KEY=